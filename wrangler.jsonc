// Configuração do Worker "scalebox" na Cloudflare.
// Antes de publicar, o wrangler roda "node gerar.js" (monta a pasta dist) e depois publica a pasta dist.
{
  "name": "scalebox",
  "compatibility_date": "2025-11-01",
  "build": {
    "command": "node gerar.js"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
