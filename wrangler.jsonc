// Configuração do Worker "scalebox" na Cloudflare.
// A cada push, a Cloudflare roda "node scripts/gerar.js" (monta a pasta dist) e publica a pasta dist.
{
  "name": "scalebox",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
